# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# App
APP_PORT=8000
DEBUG_MODE=False
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_LOG_LEVEL=INFO
DJANGO_LANGUAGE_CODE=en-gb
TIME_ZONE=Asia/Kolkata
ALLOWED_HOSTS=*
CORS_ORIGIN_ALLOW_ALL=True

# Git
GIT_USER=@your-github-username
GIT_TOKEN=your-github-personal-access-token

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=your-db-name

# Redis
REDIS_URL=redis://redis:6379

# InfluxDB
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_USER=your-influxdb-user
INFLUXDB_PASS=your-influxdb-password
INFLUXDB_NAME=your-influxdb-dbname

# Paths
MEDIA_ROOT=/opt/openwisp/media/
STATIC_ROOT=/opt/openwisp/static_collected/
PRIVATE_STORAGE_ROOT=/opt/openwisp/private/firmware

# Servers
OPENWISP_SERVER_IP=http://your-openwisp-server-ip
EXECUTOR_SERVER_IP=http://your-executor-server-ip
OPENWISP_CONTROLLER_API_HOST=http://your-openwisp-server-ip

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password

# uWSGI
UWSGI_PROCESSES=2
UWSGI_THREADS=2
UWSGI_LISTEN=100

# Misc
EXECUTION_HISTORY_AUTO_REFRESH_TIME=30

























