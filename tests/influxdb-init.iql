CREATE DATABASE openwisp2;
CREATE DATABASE openwisp2_test;

ALTER RETENTION POLICY "autogen" ON "openwisp2" DURATION 365d REPLICATION 1 DEFAULT;
CREATE RETENTION POLICY "short" ON "openwisp2" DURATION 24h REPLICATION 1;

ALTER RETENTION POLICY "autogen" ON "openwisp2_test" DURATION 1d REPLICATION 1 DEFAULT;
CREATE RETENTION POLICY "short" ON "openwisp2_test" DURATION 1h REPLICATION 1;