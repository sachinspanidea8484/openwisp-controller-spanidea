from openwisp_monitoring.monitoring.models import Chart, Metric
from openwisp_monitoring.monitoring import settings as monitoring_settings
# Get the connections metric
device_id = '5728c13c-896b-4549-a2ca-07d53b12b480'
metric = Metric.objects.filter(object_id=device_id, configuration='connections').first()
if metric:
    # Check if chart already exists
    chart_exists = Chart.objects.filter(metric=metric, configuration='connections').exists()
    
    if chart_exists:
        print("✅ Chart already exists")
    else:
        # Create the chart
        if 'connections' in monitoring_settings.AUTO_CHARTS:
            chart = Chart(metric=metric, configuration='connections')
            chart.full_clean()
            chart.save()
            print("✅ Chart created successfully!")
            print(f"   Chart ID: {chart.id}")
        else:
            print("⚠️  'connections' not in AUTO_CHARTS setting")
            print(f"   AUTO_CHARTS: {monitoring_settings.AUTO_CHARTS}")
else:
    print("❌ Metric not found for device")
exit()
from openwisp_monitoring.monitoring.models import Chart, Metric
device_id = '5728c13c-896b-4549-a2ca-07d53b12b480'
metric = Metric.objects.filter(object_id=device_id, configuration='connections').first()
if metric:
    charts = Chart.objects.filter(metric=metric)
    if charts.exists():
        chart = charts.first()
        print(f"Chart found: {chart.id} - {chart.configuration}")
        
        # Try to read chart data
        try:
            data = chart.read(time='1d')
            print("✅ Chart data read successfully!")
            print(f"   Traces: {list(data.get('traces', {}).keys())}")
            print(f"   Summary: {data.get('summary', {})}")
        except Exception as e:
            print(f"❌ Error reading chart: {e}")
            import traceback
            traceback.print_exc()
    else:
        print("❌ No chart found for connections metric")
else:
    print("❌ No connections metric found")
exit()
